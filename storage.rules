rules_version = '2';

// Regras do Firebase Storage da TCDF Plataforma (PDFs de teoria).
// Como publicar: Firebase Console → Storage → aba "Regras" → colar → "Publicar".
// Passo a passo completo em SEGURANCA.md.
service firebase.storage {
  match /b/{bucket}/o {
    // Cada conta lê e grava só a própria pasta: teoria/{uid}/...
    // Só PDF, até 50 MB por arquivo.
    match /teoria/{uid}/{materia}/{arquivo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.contentType == 'application/pdf'
                            && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
